# Perfil ativo da aplicação (dev, test, prod)
APP_PROFILE=

# Configurações do Banco de Dados - AMBIENTE DE DESENVOLVIMENTO (Local)
DATASOURCE_URL_DEV=
DATASOURCE_USERNAME_DEV=
DATASOURCE_PASSWORD_DEV=

# Configurações do Banco de Dados - AMBIENTE DE TESTE
DATASOURCE_URL_TEST=
DATASOURCE_USERNAME_TEST=
DATASOURCE_PASSWORD_TEST=

# Configurações do Banco de Dados - AMBIENTE DE PRODUÇÃO (Docker)
