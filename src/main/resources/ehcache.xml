<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
        xmlns='http://www.ehcache.org/v3'
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <!-- Configuração Padrão balanceada para VPS -->
    <cache-template name="default">
        <expiry>
            <ttl unit="hours">1</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache-template>

    <!-- Regiões de Metadados (Pequenas e Estáticas) -->
    <cache alias="com.xflprflx.neokioski.models.template.TaskStepDefinition" uses-template="default"/>
    <cache alias="com.xflprflx.neokioski.models.template.TaskFieldDefinition" uses-template="default"/>
    
    <!-- Região de Opções de Campo (Pode ser grande, mas cada entrada é leve) -->
    <cache alias="com.xflprflx.neokioski.models.template.TaskFieldOption">
        <expiry>
            <ttl unit="hours">2</ttl>
        </expiry>
        <resources>
            <heap unit="entries">5000</heap>
        </resources>
    </cache>

    <!-- Regiões de Template e Relacionamentos (Coração do Sistema) -->
    <cache alias="com.xflprflx.neokioski.models.template.TaskTemplate" uses-template="default"/>
    <cache alias="com.xflprflx.neokioski.models.template.TemplateStepRelation">
        <resources>
            <heap unit="entries">2000</heap>
        </resources>
    </cache>

    <!-- Regiões de Coleções (Essencial para o BatchSize funcionar bem com Cache) -->
    <cache alias="com.xflprflx.neokioski.models.template.TaskTemplate.templateStepRelation" uses-template="default"/>
    <cache alias="com.xflprflx.neokioski.models.template.TaskTemplate.templateFieldRelation" uses-template="default"/>
    <cache alias="com.xflprflx.neokioski.models.template.TaskTemplate.alertRoles" uses-template="default"/>
    <cache alias="com.xflprflx.neokioski.models.template.TaskTemplate.authorizingUsers" uses-template="default"/>
    <cache alias="com.xflprflx.neokioski.models.template.TaskTemplate.groups" uses-template="default"/>
    <cache alias="com.xflprflx.neokioski.models.template.TaskTemplate.alerts" uses-template="default"/>

    <cache alias="com.xflprflx.neokioski.models.template.TaskFieldDefinition.taskFieldOptions" uses-template="default"/>

    <cache alias="com.xflprflx.neokioski.models.template.TemplateStepRelation.responseOptions" uses-template="default"/>
    <cache alias="com.xflprflx.neokioski.models.template.TemplateStepRelation.allowedNextSteps" uses-template="default"/>
    <cache alias="com.xflprflx.neokioski.models.template.TemplateStepRelation.alertRoles" uses-template="default"/>

    <!-- Região de Usuários (Dinâmica, mas evita selects de perfil) -->
    <cache alias="com.xflprflx.neokioski.models.User">
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>
    <cache alias="com.xflprflx.neokioski.models.User.groups">
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <!-- Regiões Internas do Hibernate -->
    <cache alias="default-query-results-region">
        <expiry>
            <ttl unit="minutes">5</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
        </resources>
    </cache>
    <cache alias="default-update-timestamps-region">
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">5000</heap>
        </resources>
    </cache>

</config>
